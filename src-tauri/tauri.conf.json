{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoviBox",
  "version": "0.9.21",
  "identifier": "app.movibox",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MoviBox",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": [0, 0, 0, 255],
        "shadow": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "center": true,
        "additionalBrowserArgs": "--disk-cache-size=104857600"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data: blob: https: http:; connect-src 'self' ipc: http://ipc.localhost https: http: ws: wss:; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["app", "dmg", "deb", "rpm", "appimage", "nsis"],
    "resources": {
      "fonts/*": "fonts/"
    },
    "licenseFile": "installer/eula.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgl1",
          "libegl1",
          "libayatana-appindicator3-1",
          "libssl3",
          "ca-certificates"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "mesa-libGL",
          "mesa-libEGL",
          "libappindicator-gtk3",
          "openssl-libs",
          "ca-certificates"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": { "pubkey": "" },
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["movibox", "stremio"]
      }
    }
  }
}
